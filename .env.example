# Copiez ce fichier en ".env" pour tester en local. Sur Render, saisissez ces variables dans Environment.
# Exemple Gmail : activez la validation en 2 étapes, puis créez un "mot de passe d'application".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=aelia.bylaesia@gmail.com
SMTP_PASS=mot-de-passe-application
# Adresse qui reçoit les demandes
MAIL_TO=aelia.bylaesia@gmail.com
# Expéditeur affiché (doit correspondre à SMTP_USER chez la plupart des fournisseurs)
MAIL_FROM="Aélia <aelia.bylaesia@gmail.com>"
